{
  "name": "mcp-lens-monorepo",
  "private": true,
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:runtime": "npm run build --workspace=@mcp-lens/core && node packages/hook-runtime/scripts/sync-runtime.mjs",
    "verify:hooks": "npm run build --workspace=@mcp-lens/core && node scripts/verify-hook-packages.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  }
}
