{
  "name": "mcp-context-lens",
  "displayName": "MCP Context Lens",
  "description": "Automatically accounts for MCP context usage across Claude Code, Codex, and Gemini CLI.",
  "version": "0.1.1",
  "publisher": "seodduu",
  "license": "MIT",
  "icon": "media/icon.png",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "mcp",
    "claude code",
    "codex",
    "gemini cli",
    "token"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/seodduu/MCPLens"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mcp-lens.showReport",
        "title": "MCP Lens: Show Report"
      },
      {
        "command": "mcp-lens.hooksDoctor",
        "title": "MCP Lens: Hook 수집 진단"
      },
      {
        "command": "mcp-lens.hooksPause",
        "title": "MCP Lens: Hook 수집 일시 중지"
      },
      {
        "command": "mcp-lens.hooksResume",
        "title": "MCP Lens: Hook 수집 재개"
      },
      {
        "command": "mcp-lens.installHooks",
        "title": "MCP Lens: 이 클라이언트에 훅 설치",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mcp-lens.uninstallHooks",
        "title": "MCP Lens: 이 클라이언트 훅 제거"
      },
      {
        "command": "mcp-lens.removeTool",
        "title": "Remove (Claude Code에서 차단)"
      },
      {
        "command": "mcp-lens.addTool",
        "title": "Add (차단 해제)"
      },
      {
        "command": "mcp-lens.removeServer",
        "title": "Remove (서버 전체 차단)"
      },
      {
        "command": "mcp-lens.addServer",
        "title": "Add (서버 차단 해제)"
      },
      {
        "command": "mcplens.openAnalysisDetails",
        "title": "MCP Lens: Open Analysis Details"
      },
      {
        "command": "mcplens.analyzeDependencies",
        "title": "MCP Lens: Analyze Dependencies"
      },
      {
        "command": "mcplens.reanalyzeServer",
        "title": "MCP Lens: Reanalyze Server"
      },
      {
        "command": "mcplens.disableGlobally",
        "title": "MCP Lens: Disable Globally"
      },
      {
        "command": "mcplens.restoreGlobally",
        "title": "MCP Lens: Restore Globally"
      },
      {
        "command": "mcplens.withdrawInferenceConsent",
        "title": "MCP Lens: Withdraw Inference Consent"
      },
      {
        "command": "mcp-lens.scanNow",
        "title": "MCP Lens: Scan MCP Servers"
      },
      {
        "command": "mcp-lens.installHooksAll",
        "title": "MCP Lens: Install Hooks for All Clients"
      },
      {
        "command": "mcp-lens.openRolloutSetting",
        "title": "MCP Lens: Open Global Actions Setting"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mcp-lens.removeTool",
          "when": "false"
        },
        {
          "command": "mcp-lens.addTool",
          "when": "false"
        },
        {
          "command": "mcp-lens.removeServer",
          "when": "false"
        },
        {
          "command": "mcp-lens.addServer",
          "when": "false"
        },
        {
          "command": "mcp-lens.installHooks",
          "when": "false"
        },
        {
          "command": "mcp-lens.uninstallHooks",
          "when": "false"
        },
        {
          "command": "mcp-lens.hooksPause",
          "when": "!mcpLens.hooksPaused"
        },
        {
          "command": "mcp-lens.hooksResume",
          "when": "mcpLens.hooksPaused"
        },
        {
          "command": "mcplens.openAnalysisDetails",
          "when": "false"
        },
        {
          "command": "mcplens.reanalyzeServer",
          "when": "false"
        },
        {
          "command": "mcplens.disableGlobally",
          "when": "false"
        },
        {
          "command": "mcplens.restoreGlobally",
          "when": "false"
        },
        {
          "command": "mcp-lens.openRolloutSetting",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "mcp-lens.installHooks",
          "when": "view == mcpLens.collection && viewItem == hook-installable",
          "group": "inline"
        },
        {
          "command": "mcp-lens.uninstallHooks",
          "when": "view == mcpLens.collection && viewItem == hook-installed",
          "group": "1_actions"
        },
        {
          "command": "mcplens.disableGlobally",
          "when": "view == mcpLens.matrix && viewItem == mcpAnalysis-disable",
          "group": "inline"
        },
        {
          "command": "mcplens.restoreGlobally",
          "when": "view == mcpLens.matrix && viewItem == mcpAnalysis-restore",
          "group": "1_actions"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcpLens",
          "title": "MCP Lens",
          "icon": "media/lens.svg"
        }
      ]
    },
    "views": {
      "mcpLens": [
        {
          "id": "mcpLens.matrix",
          "name": "비용×사용 매트릭스"
        },
        {
          "id": "mcpLens.collection",
          "name": "수집 상태"
        }
      ]
    },
    "configuration": {
      "title": "MCP Lens",
      "properties": {
        "mcpLens.reportDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "markdownDescription": "상태바 요약과 리포트가 집계할 기간(일). 원본 클라이언트 로그는 약 30일 후 만료되지만 Lens DB에는 영구 보존되므로 더 긴 기간도 조회할 수 있습니다."
        },
        "mcpLens.reportDetail": {
          "type": "string",
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary",
          "enumDescriptions": [
            "조치 목록 위주로 요약합니다. 후보·정상 툴 목록은 상위 5개까지만 표시 (기본)",
            "모든 툴을 표시합니다"
          ],
          "markdownDescription": "`MCP Lens: 리포트 보기`의 상세 수준. 조치가 필요한 항목과 점검 대상은 설정과 무관하게 항상 전량 표시됩니다."
        },
        "mcpLens.autoScan": {
          "type": "string",
          "enum": [
            "prompt",
            "always",
            "never"
          ],
          "default": "prompt",
          "enumDescriptions": [
            "스캔할 서버가 새로 감지되면 물어봅니다 (기본)",
            "묻지 않고 자동 스캔합니다",
            "자동 스캔하지 않습니다 (npx mcp-lens scan 수동 사용)"
          ],
          "markdownDescription": "MCP 서버 툴 정의 자동 스캔. 스캔은 등록된 stdio 서버를 잠깐 실행해 tools/list를 요청합니다 — LLM 토큰을 소모하지 않고 설정 파일을 수정하지 않습니다."
        },
        "mcpLens.authIgnore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "로그인 필요 알림을 다시 띄우지 않을 MCP 서버 이름 목록. `이 서버는 묻지 않음` 버튼으로 자동 추가됩니다."
        },
        "mcpLens.unsupportedServers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Lens가 지원하지 않는다고 판정한 MCP 서버 이름 목록(자동 클라이언트 등록을 거부하는 서버 등). 로그인 시도 중 자동 추가되며, 트리에서 숨겨지고 다시 로그인을 묻지 않습니다."
        },
        "mcpLens.inferenceProvider": {
          "type": "string",
          "enum": ["auto", "claude", "codex"],
          "default": "auto",
          "markdownDescription": "Provider used for dependency analysis."
        },
        "mcpLens.claudeModel": {
          "type": "string",
          "default": "haiku",
          "markdownDescription": "Claude model used for dependency analysis."
        },
        "mcpLens.codexModel": {
          "type": "string",
          "default": "gpt-5.6-luna",
          "markdownDescription": "Codex model used for dependency analysis."
        },
        "mcplens.dependencyAnalysis.rollout": {
          "type": "string",
          "enum": ["shadow", "claude", "codex-beta", "stable"],
          "default": "shadow",
          "markdownDescription": "Controls which dependency-analysis action surfaces are available. Shadow allows analysis, cache, and details only."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "mcpLens.setup",
        "title": "Get started with MCP Lens",
        "description": "Measure what your MCP tools cost, then decide what to turn off.",
        "steps": [
          {
            "id": "scan",
            "title": "Scan your MCP servers",
            "description": "Measure how many tokens each tool definition costs in every prompt. Lens briefly starts each configured server and calls tools/list. No LLM tokens are spent and no config file is modified.\n[Scan now](command:mcp-lens.scanNow)",
            "media": { "image": "media/walkthrough/scan.svg", "altText": "Scanning MCP servers" },
            "completionEvents": ["onContext:mcpLens.scanReady"]
          },
          {
            "id": "hooks",
            "title": "Turn on usage collection",
            "description": "Install hooks into your AI coding clients. Hooks record how often each tool is actually called, which is what definition cost is compared against.\nCodex also needs you to approve the hooks under /hooks. Gemini CLI needs a restart. Either way, collection starts with your next session.\nSetup Status in the sidebar always shows the live state.\n[Install hooks](command:mcp-lens.installHooksAll)",
            "media": { "image": "media/walkthrough/hooks.svg", "altText": "Installing hooks" },
            "completionEvents": ["onContext:mcpLens.hooksReady"]
          },
          {
            "id": "analyze",
            "title": "Analyze tool dependencies",
            "description": "Find out which tools depend on which. Only tool definitions and aggregated usage counts are sent. Prompts, tool inputs, tool outputs and source code are never sent.\n[Analyze](command:mcplens.analyzeDependencies)",
            "media": { "image": "media/walkthrough/analyze.svg", "altText": "Analyzing dependencies" },
            "completionEvents": ["onContext:mcpLens.analysisReady"]
          },
          {
            "id": "actions",
            "title": "Enable global actions (optional)",
            "description": "Let Lens turn unused tools off for you by editing your client config. This is locked by default.\n[Open setting](command:mcp-lens.openRolloutSetting)",
            "media": { "image": "media/walkthrough/actions.svg", "altText": "Enabling global actions" },
            "completionEvents": ["onSettingChanged:mcplens.dependencyAnalysis.rollout"]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/bundle-smoke.mjs",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "@mcp-lens/core": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
