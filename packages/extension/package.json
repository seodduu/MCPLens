{
  "name": "mcp-context-lens",
  "displayName": "MCP Context Lens",
  "description": "Automatically accounts for MCP context usage across Claude Code, Codex, and Gemini CLI.",
  "version": "0.3.0",
  "publisher": "seodduu",
  "license": "MIT",
  "icon": "media/icon.png",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "mcp",
    "claude code",
    "codex",
    "gemini cli",
    "token"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/seodduu/MCPLens"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mcp-lens.showReport",
        "title": "MCP Lens: Show Report"
      },
      {
        "command": "mcp-lens.hooksDoctor",
        "title": "MCP Lens: Hook Collection Diagnostics"
      },
      {
        "command": "mcp-lens.hooksPause",
        "title": "MCP Lens: Pause Hook Collection"
      },
      {
        "command": "mcp-lens.hooksResume",
        "title": "MCP Lens: Resume Hook Collection"
      },
      {
        "command": "mcp-lens.installHooks",
        "title": "MCP Lens: Install Hooks for This Client",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mcp-lens.uninstallHooks",
        "title": "MCP Lens: Remove Hooks for This Client"
      },
      {
        "command": "mcp-lens.removeTool",
        "title": "Remove (block in Claude Code)"
      },
      {
        "command": "mcp-lens.addTool",
        "title": "Add (unblock)"
      },
      {
        "command": "mcp-lens.removeServer",
        "title": "Remove (block entire server)"
      },
      {
        "command": "mcp-lens.addServer",
        "title": "Add (unblock server)"
      },
      {
        "command": "mcplens.openAnalysisDetails",
        "title": "MCP Lens: Open Analysis Details"
      },
      {
        "command": "mcplens.analyzeDependencies",
        "title": "MCP Lens: Analyze Dependencies"
      },
      {
        "command": "mcplens.reanalyzeServer",
        "title": "MCP Lens: Reanalyze Server"
      },
      {
        "command": "mcplens.disableGlobally",
        "title": "MCP Lens: Disable Globally"
      },
      {
        "command": "mcplens.restoreGlobally",
        "title": "MCP Lens: Restore Globally"
      },
      {
        "command": "mcplens.withdrawInferenceConsent",
        "title": "MCP Lens: Withdraw Inference Consent"
      },
      {
        "command": "mcp-lens.scanNow",
        "title": "MCP Lens: Scan MCP Servers"
      },
      {
        "command": "mcp-lens.installHooksAll",
        "title": "MCP Lens: Install Hooks for All Clients"
      },
      {
        "command": "mcp-lens.openRolloutSetting",
        "title": "MCP Lens: Open Global Actions Setting"
      },
      {
        "command": "mcp-lens.authenticateServer",
        "title": "MCP Lens: Sign In to Server"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mcp-lens.removeTool",
          "when": "false"
        },
        {
          "command": "mcp-lens.addTool",
          "when": "false"
        },
        {
          "command": "mcp-lens.removeServer",
          "when": "false"
        },
        {
          "command": "mcp-lens.addServer",
          "when": "false"
        },
        {
          "command": "mcp-lens.installHooks",
          "when": "false"
        },
        {
          "command": "mcp-lens.uninstallHooks",
          "when": "false"
        },
        {
          "command": "mcp-lens.hooksPause",
          "when": "!mcpLens.hooksPaused"
        },
        {
          "command": "mcp-lens.hooksResume",
          "when": "mcpLens.hooksPaused"
        },
        {
          "command": "mcplens.openAnalysisDetails",
          "when": "false"
        },
        {
          "command": "mcplens.reanalyzeServer",
          "when": "false"
        },
        {
          "command": "mcplens.disableGlobally",
          "when": "false"
        },
        {
          "command": "mcplens.restoreGlobally",
          "when": "false"
        },
        {
          "command": "mcp-lens.openRolloutSetting",
          "when": "false"
        },
        {
          "command": "mcp-lens.authenticateServer",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "mcp-lens.installHooks",
          "when": "view == mcpLens.collection && viewItem == hook-installable",
          "group": "inline"
        },
        {
          "command": "mcp-lens.uninstallHooks",
          "when": "view == mcpLens.collection && viewItem == hook-installed",
          "group": "1_actions"
        },
        {
          "command": "mcplens.disableGlobally",
          "when": "view == mcpLens.matrix && viewItem == mcpAnalysis-disable",
          "group": "inline"
        },
        {
          "command": "mcplens.restoreGlobally",
          "when": "view == mcpLens.matrix && viewItem == mcpAnalysis-restore",
          "group": "1_actions"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcpLens",
          "title": "MCP Lens",
          "icon": "media/lens.svg"
        }
      ]
    },
    "views": {
      "mcpLens": [
        {
          "id": "mcpLens.matrix",
          "name": "Cost × Usage Matrix"
        },
        {
          "id": "mcpLens.collection",
          "name": "Collection Status"
        },
        {
          "id": "mcpLens.setupStatus",
          "name": "Setup Status"
        }
      ]
    },
    "configuration": {
      "title": "MCP Lens",
      "properties": {
        "mcpLens.reportDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "markdownDescription": "Number of days the status bar summary and reports aggregate over. Original client logs expire after about 30 days, but the Lens DB retains data permanently, so longer periods can also be queried."
        },
        "mcpLens.reportDetail": {
          "type": "string",
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary",
          "enumDescriptions": [
            "Summarizes with a focus on the action list. Candidate and normal tool lists show only the top 5 (default)",
            "Shows every tool"
          ],
          "markdownDescription": "Detail level for `MCP Lens: Show Report`. Items needing action and items to inspect are always shown in full regardless of this setting."
        },
        "mcpLens.autoScan": {
          "type": "string",
          "enum": [
            "prompt",
            "always",
            "never"
          ],
          "default": "prompt",
          "enumDescriptions": [
            "Asks when a new server to scan is detected (default)",
            "Scans automatically without asking",
            "Never scans automatically (use `npx mcp-lens scan` manually)"
          ],
          "markdownDescription": "Automatic scanning of MCP server tool definitions. Scanning briefly runs each registered stdio server and requests tools/list. No LLM tokens are spent and no config file is modified."
        },
        "mcpLens.authIgnore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "MCP server names for which the sign-in-required notification will not be shown again. Automatically added via the `Don't ask for this server` button."
        },
        "mcpLens.unsupportedServers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "MCP server names that Lens has determined it does not support (for example, servers that reject automatic client registration). Automatically added during a sign-in attempt; these servers are hidden from the tree and never prompted for sign-in again."
        },
        "mcpLens.inferenceProvider": {
          "type": "string",
          "enum": [
            "auto",
            "claude",
            "codex"
          ],
          "default": "auto",
          "markdownDescription": "Provider used for dependency analysis."
        },
        "mcpLens.claudeModel": {
          "type": "string",
          "default": "haiku",
          "markdownDescription": "Claude model used for dependency analysis."
        },
        "mcpLens.codexModel": {
          "type": "string",
          "default": "gpt-5.6-luna",
          "markdownDescription": "Codex model used for dependency analysis."
        },
        "mcplens.dependencyAnalysis.rollout": {
          "type": "string",
          "enum": [
            "shadow",
            "claude",
            "codex-beta",
            "stable"
          ],
          "default": "shadow",
          "markdownDescription": "Controls which dependency-analysis action surfaces are available. Shadow allows analysis, cache, and details only."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "mcpLens.setup",
        "title": "Get started with MCP Lens",
        "description": "Measure what your MCP tools cost, then decide what to turn off.",
        "steps": [
          {
            "id": "scan",
            "title": "Scan your MCP servers",
            "description": "Measure how many tokens each tool definition costs in every prompt. Lens briefly starts each configured server and calls tools/list. No LLM tokens are spent and no config file is modified.\n[Scan now](command:mcp-lens.scanNow)",
            "media": {
              "image": "media/walkthrough/scan.svg",
              "altText": "Scanning MCP servers"
            },
            "completionEvents": [
              "onContext:mcpLens.scanReady"
            ]
          },
          {
            "id": "hooks",
            "title": "Turn on usage collection",
            "description": "Install hooks into your AI coding clients. Hooks record how often each tool is actually called, which is what definition cost is compared against.\nCodex also needs you to approve the hooks under /hooks. Gemini CLI needs a restart. Either way, collection starts with your next session.\nSetup Status in the sidebar always shows the live state.\n[Install hooks](command:mcp-lens.installHooksAll)",
            "media": {
              "image": "media/walkthrough/hooks.svg",
              "altText": "Installing hooks"
            },
            "completionEvents": [
              "onContext:mcpLens.hooksReady"
            ]
          },
          {
            "id": "analyze",
            "title": "Analyze tool dependencies",
            "description": "Find out which tools depend on which. Only tool definitions and aggregated usage counts are sent. Prompts, tool inputs, tool outputs and source code are never sent.\n[Analyze](command:mcplens.analyzeDependencies)",
            "media": {
              "image": "media/walkthrough/analyze.svg",
              "altText": "Analyzing dependencies"
            },
            "completionEvents": [
              "onContext:mcpLens.analysisReady"
            ]
          },
          {
            "id": "actions",
            "title": "Enable global actions (optional)",
            "description": "Let Lens turn unused tools off for you by editing your client config. This is locked by default.\n[Open setting](command:mcp-lens.openRolloutSetting)",
            "media": {
              "image": "media/walkthrough/actions.svg",
              "altText": "Enabling global actions"
            },
            "completionEvents": [
              "onSettingChanged:mcplens.dependencyAnalysis.rollout"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/bundle-smoke.mjs",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "@mcp-lens/core": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
