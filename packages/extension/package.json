{
  "name": "mcp-lens",
  "displayName": "MCP Lens",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mcp-lens.showReport",
        "title": "MCP Lens: Show Report"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcpLens",
          "title": "MCP Lens",
          "icon": "media/lens.svg"
        }
      ]
    },
    "views": {
      "mcpLens": [
        {
          "id": "mcpLens.matrix",
          "name": "비용×사용 매트릭스"
        }
      ]
    },
    "configuration": {
      "title": "MCP Lens",
      "properties": {
        "mcpLens.reportDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "markdownDescription": "상태바 요약과 리포트가 집계할 기간(일). 원본 클라이언트 로그는 약 30일 후 만료되지만 Lens DB에는 영구 보존되므로 더 긴 기간도 조회할 수 있습니다."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mcp-lens/core": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}